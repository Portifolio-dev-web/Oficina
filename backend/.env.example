# Origens permitidas no CORS (separadas por vírgula). "*" é aceitável porque
# a API não usa cookie (allow_credentials=False — ver item S6 da auditoria),
# mas em produção prefira listar os domínios reais (ex.: https://app.seudominio.com).
CORS_ORIGINS=*

# --- Supabase (obrigatório) --------------------------------------------
# URL e chaves do seu projeto: Supabase Dashboard > Project Settings > API.
# SUPABASE_SERVICE_ROLE_KEY tem acesso total ao banco (ignora RLS) — nunca
# exponha essa chave ao frontend, somente ao backend.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Administrador -------------------------------------------------------
# ADMIN_USERNAME é apenas um alias aceito no login (mapeado para ADMIN_EMAIL
# dentro do backend). A conta real (e a senha) vive no Supabase Auth — use
# backend/scripts/create_admin.py uma vez para criá-la. ADMIN_PASSWORD abaixo
# só é lido por esse script de setup, nunca em tempo de execução da API.
# SEGURANÇA (auditoria, item S3): nunca coloque aqui uma senha real — este
# arquivo é versionado no Git. Defina uma senha forte só no seu backend/.env
# local (fora do controle de versão) antes de rodar create_admin.py.
ADMIN_USERNAME=admin
ADMIN_EMAIL=monitor.informatica25@gmail.com
ADMIN_PASSWORD=defina-uma-senha-forte-aqui

# --- E-mail (verificação de cadastro e notificação de status) - opcional ---
# Sem SENDGRID_API_KEY preenchida, tanto o código de verificação de cadastro
# quanto as notificações de status do agendamento continuam só gerando um
# log "[E-mail simulado]" (comportamento padrão deste projeto de
# demonstração — não precisa de conta em nenhum provedor para rodar).
# Preenchendo-a, o backend manda o e-mail de verdade via SendGrid
# (https://sendgrid.com):
#   SENDGRID_API_KEY: SendGrid Dashboard > Settings > API Keys.
#   SENDGRID_FROM_EMAIL: remetente verificado via "Single Sender
#     Verification" (Settings > Sender Authentication) — um único e-mail,
#     sem precisar de domínio próprio, mas só depois de verificado a
#     SendGrid aceita enviar para qualquer destinatário.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=Oficina Fácil <naoresponda@seudominio.com>
