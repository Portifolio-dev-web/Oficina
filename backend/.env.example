# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGINS=*

# --- Supabase (obrigatório) --------------------------------------------
# URL e chaves do seu projeto: Supabase Dashboard > Project Settings > API.
# SUPABASE_SERVICE_ROLE_KEY tem acesso total ao banco (ignora RLS) — nunca
# exponha essa chave ao frontend, somente ao backend.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Administrador -------------------------------------------------------
# ADMIN_USERNAME é apenas um alias aceito no login (mapeado para ADMIN_EMAIL
# dentro do backend). A conta real (e a senha) vive no Supabase Auth — use
# backend/scripts/create_admin.py uma vez para criá-la. ADMIN_PASSWORD abaixo
# só é lido por esse script de setup, nunca em tempo de execução da API.
# SEGURANÇA (auditoria, item S3): nunca coloque aqui uma senha real — este
# arquivo é versionado no Git. Defina uma senha forte só no seu backend/.env
# local (fora do controle de versão) antes de rodar create_admin.py.
ADMIN_USERNAME=admin
ADMIN_EMAIL=monitor.informatica25@gmail.com
ADMIN_PASSWORD=defina-uma-senha-forte-aqui

# --- Testes de integração (opcional) -------------------------------------
# Cadastre esse número em Supabase Dashboard > Authentication > Test phone
# numbers com um código OTP fixo, para rodar os testes de login de cliente
# sem depender de um SMS real.
TEST_OTP_PHONE=
TEST_OTP_CODE=
