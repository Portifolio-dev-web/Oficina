    "workshop_garage": "https://images.unsplash.com/photo-1676018366904-c083ed678e60?crop=entropy&cs=srgb&fm=jpg&ixid=M3w4NTYxOTF8MHwxfHNlYXJjaHwyfHxjYXIlMjBtZWNoYW5pYyUyMHJlcGFpciUyMHdvcmtzaG9wJTIwYXV0b21vdGl2ZSUyMHNlcnZpY2V8ZW58MHx8fHwxNzg4Mzg3MzM0fDA&ixlib=rb-4.1.0&q=85"
  },
  "testing_requirements": {
    "data_testid_convention": "kebab-case",
    "mandatory_testids": [
      "nav-brand-logo",
      "btn-open-onboarding",
      "input-phone-number",
      "btn-send-otp",
      "input-otp-digit-0",
      "btn-verify-otp",
      "select-vehicle-brand",
      "select-vehicle-model",
      "input-vehicle-plate",
      "tab-category-preventiva",
      "tab-category-reparacao",
      "tab-category-diagnostico",
      "card-service-item",
      "btn-proceed-booking",
      "calendar-booking-date",
      "btn-slot-manha",
      "btn-slot-tarde",
      "btn-confirm-booking",
      "tracking-stepper",
      "stepper-stage-item",
      "btn-demo-advance-stage",
      "btn-demo-regress-stage",
      "tab-sms-feed",
      "sms-feed-list"
    ]
  },
  "instructions_to_main_agent": [
    "Use dark slate base styling (#0F172A for page background, #1E293B for cards/surfaces, #334155 for borders).",
    "Apply emerald badges for completed/active stages and amber badges for pending or high attention stages.",
    "Use Framer Motion AnimatePresence for tab switching, OTP modal entrance, and stepper stage progress animations.",
    "Ensure all copy is localized into Portuguese (pt-BR) as requested.",
    "Add explicit data-testid attributes to all interactive components.",
    "Ensure responsiveness on mobile viewports for live tracking stepper."
  ]
}