# URL base da API. Deixe vazio quando o frontend e a API estiverem no mesmo domínio (ex.: Docker + nginx).
REACT_APP_BACKEND_URL=http://localhost:8000

# E-mail de contato exibido na página pública /privacidade (LGPD, item L3).
# Se vazio, a página usa um e-mail de exemplo — defina o real antes de publicar.
REACT_APP_PRIVACY_CONTACT_EMAIL=

